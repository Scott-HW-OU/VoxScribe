# GEMINI_API_KEY: Required for Gemini AI API calls (call transcription, summarization, and keyword tagging).
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# NOTION_API_KEY: Optional Notion Internal Integration Secret for direct 1-click Notion API page creation.
# Configure via the Secrets panel in AI Studio UI.
NOTION_API_KEY=MY_NOTION_API_KEY
